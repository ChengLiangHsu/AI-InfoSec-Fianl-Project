# 複製成 .env，僅在本機或主機上填入金鑰，不提交 Git。
PYDANTIC_AI_MODEL=google:gemini-3.7-flash
GEMINI_API_KEY=
LOGFIRE_TOKEN=

# 本機 Compose：http://localhost:8000
APP_PORT=8000
APP_IMAGE_TAG=local
COOKIE_SECURE=false
PUBLIC_ORIGIN=

# 公開上線時設定實際子網域，COOKIE_SECURE 改成 true。
SITE_DOMAIN=
# PUBLIC_ORIGIN=https://你的子網域.duckdns.org

# 容量預設：3 件待處理，一次拼接 1 件。
MAX_IMAGES=100
MAX_IMAGE_BYTES=26214400
MAX_UPLOAD_BYTES=1073741824
MAX_ACTIVE_TASKS=3
MAX_CHAT_REQUESTS_PER_DAY=100
ODM_MAX_CONCURRENCY=3
